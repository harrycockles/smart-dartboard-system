[Unit]
Description=Smart Dartboard Vision Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dartboard
WorkingDirectory=/home/dartboard/smart-dartboard-system/pi-vision
ExecStart=/usr/bin/python3 /home/dartboard/smart-dartboard-system/pi-vision/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
