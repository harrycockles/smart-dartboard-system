[Unit]
Description=Smart Dartboard Vision Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/PiDartVision
ExecStart=/usr/bin/python3 /home/pi/PiDartVision/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
